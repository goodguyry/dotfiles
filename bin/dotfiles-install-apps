# ------------------------------------------------------------------------------
# usage: dotfiles install apps
#
# Installs Homebrew casks and App Store apps
# ------------------------------------------------------------------------------

# Force calling via `dotfiles`.
if [ "${BASH_SOURCE[0]}" -ef "${0}" ]; then
  printf 'usage: %s\n' "$(basename -- "$0" | sed -e 's/-/ /g')";
  exit 1;
fi

# Capture the dotfiles directory.
dotfiles_root=$(dotfiles --prefix);

# Source setup files.
source "${HOME}/.dotfiles/lib/dohomebrew";

# Homebrew is required.
status 'Checking for Homebrew';
dohomebrew;

# Trusted taps.
brew trust espanso/espanso;

# Install apps.
brew bundle install --file "${dotfiles_root}/etc/brew-apps";
