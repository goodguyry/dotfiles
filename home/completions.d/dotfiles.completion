#!/bin/bash

# Adds subcommand completion for `dotfiles`.
__dotfiles_completion() {
  local cur;
  local prev;
  local subcommands;

  # Get all symlinked command files.
  subcommands=$(find \
    ~/.dotfiles/ \
    -maxdepth 1 \
    -mindepth 1 \
    -type l \
    -iname 'dotfiles-*' \
    -print0 | xargs -0 basename);

  cur=${COMP_WORDS[COMP_CWORD]};
  prev="${COMP_WORDS[COMP_CWORD-1]}";

  COMPREPLY=();

  case ${COMP_CWORD} in
    1)
      # First word is always a subcommand.
      mapfile -t COMPREPLY < <(compgen -W "install run set sync --prefix" -- "${cur}");
      ;;
    2)
      # Second word is an option for the subcommand.
      # @todo Move `run` commands to `set`.
      local COMPLETE_LIST="";
      for SUBCOMMAND in ${subcommands}; do
        if [[ "${SUBCOMMAND}" == "dotfiles-${prev}-${cur}"* ]]; then
          COMPLETE_LIST+="${SUBCOMMAND#dotfiles-${prev}-} ";
        fi
      done;

      mapfile -t COMPREPLY < <(compgen -W "${COMPLETE_LIST}" -- "${cur}");
      ;;
    *)
      # Do nothing.
      ;;
  esac
  return 0;
}

complete -F __dotfiles_completion dotfiles;
