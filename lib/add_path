# Capture the dotfiles directory.
dotfiles_root=$(dotfiles --prefix);

source "${HOME}/.dotfiles/lib/status";

# Add a path to the specified paths.d/* file.
function add_path() {
  local segment="${1}";
  local file="${2}";
  local prefix="${3}";

  dotfiles_path=$(dotfiles --prefix "${prefix}");
  path_file="${dotfiles_path}/${file}";

  # Path files are gitignored.
  if [[ ! -f "${path_file}" ]]; then
    touch "${path_file}";
  fi

  if ! grep -q ""${segment}"" "${path_file}"; then
    echo "${segment}"|sudo tee -a "${path_file}" > /dev/null;

    if [[ $? ]]; then
      status --success "Path added to ${file}: ${segment}";
    else
      status --error "Error adding ${file}: ${segment}";
    fi
  fi;
}
